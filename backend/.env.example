APP_NAME=Kapture Finance AI Collections Voice Agent
APP_VERSION=1.0.0
ENVIRONMENT=production

DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database>

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

LOG_LEVEL=INFO

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
